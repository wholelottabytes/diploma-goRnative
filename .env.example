# BeatMarket Environment Variables
# Copy this file to .env and update values for your environment

# ==================== SECURITY ====================
# Generate a secure JWT secret: ./scripts/generate_jwt_secret.sh
# IMPORTANT: Change this in production!
JWT_SECRET=change-me-in-production-use-a-secure-random-string-at-least-32-chars

# ==================== DATABASES ====================
# PostgreSQL (Wallet Service)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-in-production

# ClickHouse (Analytics Service)
CLICKHOUSE_USER=user
CLICKHOUSE_PASSWORD=change-me-in-production

# ==================== MINIO ====================
# MinIO credentials (for beat file storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# ==================== NETWORK ====================
# Your server's public IP (for MinIO public access)
# This should be the IP that clients can reach
MINIO_PUBLIC_ENDPOINT=http://localhost:9010
# For production, use your server's public IP:
# MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9010
